---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import letabli from "../assets/images/letabli.webp";
import ninaCarducci from "../assets/images/nina-carducci.webp";
import argentBank from "../assets/images/argent-bank.webp";
import { projectDetails } from "../data/project-details";
---

<Layout
	title="Léa Spadea — Développeuse web"
	description="Portfolio de Léa Spadea, développeuse web spécialisée en intégration et React."
>
	<Hero />
	<main id="main-content">
		<section id="collection" class="section">
			<div class="container">
				
				<div class="divider" aria-hidden="true">
					<svg
						width="64"
						height="16"
						viewBox="0 0 64 16"
						fill="none"
						stroke="currentColor"
						stroke-width="1.2"
					>
						<circle cx="6" cy="8" r="2"></circle>
						<path d="M20 8 L32 2 L44 8 L32 14 Z"></path>
						<circle cx="58" cy="8" r="2"></circle>
					</svg>
				</div>

				<p class="section-eyebrow">Inventaire</p>
				<h2 class="section-title collection__title">La <em>collection</em></h2>
				<p class="section-subtitle collection__subtitle">
					Projets de formation et réalisation pour une cliente, chacun avec
					son numéro d'inventaire.
				</p>

				<ProjectCard
						featured={true}
						number={1}
						title="L'Établi"
						category="Commande réelle"
						status="En cours de finalisation"
						details={projectDetails.letabli}
						description="Site vitrine pour un salon de tatouage, conçu et développé pour une cliente."
						image={letabli}
						tags={["Astro", "CSS", "React"]}
						repoUrl="https://github.com/leaspadea/L_etabli"
					/>

					<div class="projects-grid">
						<ProjectCard
							number={2}
							title="Argent Bank"
							category="Projet de formation"
							status="Réalisé"
							details={projectDetails.argentBank}
							description="Intégration front-end d'une application bancaire : authentification, gestion de profil et state management avec React et Redux."
							image={argentBank}
							tags={["React", "Redux", "React Router", "Vite", "API"]}
							repoUrl="https://github.com/leaspadea/argent-bank"
						/>
						<ProjectCard
							number={3}
							title="Nina Carducci"
							category="Projet de formation"
							status="Réalisé"
							details={projectDetails.ninaCarducci}
							description="Optimisation SEO, performance & accessibilité d'un site de photographe"
							image={ninaCarducci}
							tags={["HTML", "CSS", "SEO", "JavaScript", "Accessibilité"]}
							siteUrl="https://leaspadea.github.io/nina-carducci/"
							repoUrl="https://github.com/leaspadea/nina-carducci"
						/>
					</div>
				</div>
			</section>
			<About />
			<Contact />
	</main>
</Layout>

<style>
  .collection__title,
  .collection__subtitle {
    text-align: center;
  }

  .collection__subtitle {
    max-width: 50rem;
    margin-inline: auto;
  }
</style>
