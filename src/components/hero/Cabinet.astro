---
// Armoire de l'intro : deux portes qui recouvrent le hero, ouvertes par
// src/scripts/hero-intro.ts. Elle n'est affichée que si le mini-script de
// Hero.astro a ajouté la classe « intro » sur <html>.
---

<div class="cabinet" aria-hidden="true">
  <div class="cabinet__shadow"></div>
  <div class="cabinet__slit"></div>
  <div class="cabinet__door cabinet__door--left">
    <div class="cabinet__panel cabinet__panel--top"></div>
    <div class="cabinet__panel cabinet__panel--bottom"></div>
    <span class="cabinet__knob"></span>
    <span class="cabinet__edge"></span>
  </div>
  <div class="cabinet__door cabinet__door--right">
    <div class="cabinet__panel cabinet__panel--top"></div>
    <div class="cabinet__panel cabinet__panel--bottom"></div>
    <span class="cabinet__knob"></span>
    <span class="cabinet__edge"></span>
  </div>
</div>

<style>
  .cabinet {
    /* Veinage du bois, réutilisé sur les portes, les cadres et les creux */
    --wood-grain:
      repeating-linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.14) 0 1px,
        transparent 1px 7px,
        rgba(233, 226, 208, 0.03) 7px 8px,
        transparent 8px 19px
      ),
      repeating-linear-gradient(
        90deg,
        transparent 0 43px,
        rgba(0, 0, 0, 0.16) 43px 45px,
        transparent 45px 97px
      );
    position: absolute;
    inset: 0;
    perspective: 900px;
    display: none;
  }

  :global(html.intro) .cabinet {
    display: flex;
    animation: cabinet-fallback 0s 6s forwards;
  }

  @keyframes cabinet-fallback {
    to {
      visibility: hidden;
    }
  }

  /* Filet clair qui fait le tour de l'armoire */
  .cabinet::after {
    content: "";
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(233, 226, 208, 0.1);
    pointer-events: none;
  }

  .cabinet__shadow,
  .cabinet__slit {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .cabinet__door {
    flex: 1;
    position: relative;
    transform-style: preserve-3d;
    background: var(--wood-grain), var(--color-bg-forest);
  }

  /* Jonction : trait sombre sur la porte gauche, reflet sur la droite */
  .cabinet__door--left {
    transform-origin: 0% 50%;
    box-shadow: inset -2px 0 0 rgba(0, 0, 0, 0.7);
  }

  .cabinet__door--right {
    transform-origin: 100% 50%;
    box-shadow: inset 1px 0 0 rgba(233, 226, 208, 0.12);
  }

  /* Cadre de moulure uni, sans veinage */
  .cabinet__panel {
    position: absolute;
    border: 7px solid;
    border-color: #22392e #0d1b15 #0d1b15 #22392e;
    background-color: #152820;
  }

  /* Creux : veinage plus fin et plus serré que celui de la porte */
  .cabinet__panel::before {
    content: "";
    position: absolute;
    inset: 10px;
    background:
      repeating-linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.12) 0 1px,
        transparent 1px 4px,
        rgba(233, 226, 208, 0.025) 4px 5px,
        transparent 5px 9px
      ),
      #10201a;
    box-shadow:
      inset 3px 3px 8px rgba(0, 0, 0, 0.55),
      inset -1px -1px 0 rgba(233, 226, 208, 0.07);
  }

  .cabinet__door--left .cabinet__panel {
    left: 20px;
    right: 40px;
  }

  .cabinet__door--right .cabinet__panel {
    left: 40px;
    right: 20px;
  }

  .cabinet__panel--top {
    top: 20px;
    bottom: 180px;
  }

  .cabinet__panel--bottom {
    top: calc(100% - 160px);
    bottom: 20px;
  }

  .cabinet__knob {
    position: absolute;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    top: calc(50% - 12px);
    background-color: var(--color-accent-brass);
    box-shadow:
      inset 0 0 0 4px var(--color-accent-brass-shadow),
      0 3px 6px rgba(0, 0, 0, 0.55);
  }

  .cabinet__knob::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 3px;
    height: 9px;
    background-color: #3b2d19;
  }

  .cabinet__door--left .cabinet__knob {
    right: 16px;
  }

  .cabinet__door--right .cabinet__knob {
    left: 16px;
  }

  .cabinet__edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 18px;
    background-color: #09120e;
  }

  .cabinet__door--left .cabinet__edge {
    right: 1px;
    transform-origin: 100% 50%;
    transform: rotateY(-90deg);
  }

  .cabinet__door--right .cabinet__edge {
    left: 1px;
    transform-origin: 0% 50%;
    transform: rotateY(90deg);
  }

  .cabinet__shadow {
    background-color: var(--color-bg-deep);
  }

  .cabinet__slit {
    width: 360px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(232, 200, 140, 0.07) 22%,
      rgba(240, 214, 160, 0.4) 50%,
      rgba(232, 200, 140, 0.07) 78%,
      transparent
    );
    left: calc(50% - 180px);
    inset-block: -10%;
  }

  @media (min-width: 768px) {
    .cabinet {
      perspective: 1600px;
    }

    .cabinet__door--left .cabinet__panel {
      left: 44px;
      right: 72px;
    }

    .cabinet__panel::before {
      inset: 22px;
    }

    .cabinet__door--right .cabinet__panel {
      left: 72px;
      right: 44px;
    }

    .cabinet__panel--top {
      top: 44px;
      bottom: 260px;
    }

    .cabinet__panel--bottom {
      top: calc(100% - 216px);
      bottom: 44px;
    }

    .cabinet__panel {
      border-width: 12px;
    }

    .cabinet__knob {
      width: 36px;
      height: 36px;
      top: calc(50% - 18px);
    }

    .cabinet__knob::before {
      height: 16px;
      width: 4px;
    }
  }
</style>
