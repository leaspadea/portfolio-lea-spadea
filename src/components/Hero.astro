<section class="hero">
  <div class="hero__vitrine" aria-hidden="true">
    <svg
      class="hero__corner hero__corner--tl"
      viewBox="0 0 56 56"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
    >
      <path d="M2 50 V2 H50"></path>
      <path d="M12 36 V12 H36"></path>
      <circle cx="12" cy="12" r="2.5" fill="currentColor"></circle>
      <path d="M20 20 L26 26"></path>
    </svg>
    <svg
      class="hero__corner hero__corner--tr"
      viewBox="0 0 56 56"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
    >
      <path d="M2 50 V2 H50"></path>
      <path d="M12 36 V12 H36"></path>
      <circle cx="12" cy="12" r="2.5" fill="currentColor"></circle>
      <path d="M20 20 L26 26"></path>
    </svg>
    <svg
      class="hero__corner hero__corner--bl"
      viewBox="0 0 56 56"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
    >
      <path d="M2 50 V2 H50"></path>
      <path d="M12 36 V12 H36"></path>
      <circle cx="12" cy="12" r="2.5" fill="currentColor"></circle>
      <path d="M20 20 L26 26"></path>
    </svg>
    <svg
      class="hero__corner hero__corner--br"
      viewBox="0 0 56 56"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
    >
      <path d="M2 50 V2 H50"></path>
      <path d="M12 36 V12 H36"></path>
      <circle cx="12" cy="12" r="2.5" fill="currentColor"></circle>
      <path d="M20 20 L26 26"></path>
    </svg>
  </div>

  <div class="container hero__inner">
    <!-- Colonne texte -->
    <div class="hero__text">
      <p class="hero__eyebrow">
        <span class="hero__eyebrow-line">Développeuse web</span>
        <span class="hero__eyebrow-sep" aria-hidden="true"> · </span>
        <span class="hero__eyebrow-line">Cabinet de curiosités numériques</span>
      </p>
      <h1 class="hero__title">Léa Spadea</h1>
      <p class="hero__subtitle">
        De la maquette au code, je crée des interfaces web accessibles et
        performantes, avec le soin d'un objet fait main.
      </p>
      <div class="hero__actions">
        <a class="btn-primary" href="#collection">Voir la collection</a>
        <a class="btn-outline" href="#correspondance">M'écrire une lettre</a>
      </div>
    </div>

    <!-- Médaillon portrait -->
    <figure class="hero__medallion">
      <div class="hero__swing">
        <svg
          class="hero__nail"
          width="140"
          height="40"
          viewBox="0 0 140 40"
          aria-hidden="true"
          stroke="currentColor"
          stroke-width="1.2"
          fill="none"
        >
          <path d="M70 4 L30 40 M70 4 L110 40"></path>
          <circle cx="70" cy="4" r="3.5" fill="currentColor"></circle>
          <circle cx="70" cy="4" r="1.5" fill="#0B1A14"></circle>
        </svg>
        <div class="hero__portrait-frame">
          <img
            src="/images/portrait.webp"
            alt="Portrait de Léa Spadea"
            width="520"
            height="660"
          />
        </div>
      </div>
      <figcaption class="hero__tag">
        <div class="hero__tag-hang">
          <div class="hero__tag-shadow">
            <div class="hero__tag-card">
              <span class="hero__tag-eyelet" aria-hidden="true"></span>
              <p class="hero__tag-title">Spécimen · 2026</p>
              <dl class="hero__tag-list">
                <dt class="hero__tag-desktop">Nom</dt>
                <dd class="hero__tag-desktop">Léa Spadea</dd>
                <dt>Espèce</dt>
                <dd><i>Integratrix web</i></dd>
                <dt>Habitat</dt>
                <dd>VS Code</dd>
                <dt><abbr title="Signe particulier">Signe part.</abbr></dt>
                <dd>Ex-vendeuse&nbsp;: écoute avant de coder</dd>
              </dl>
            </div>
          </div>
        </div>
      </figcaption>
    </figure>
  </div>

  <a class="hero__scroll" href="#collection">
    Ouvrir la collection
    <span aria-hidden="true">↓</span>
  </a>

  <style>
    .hero {
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      /* Hauteur de l'écran visible, moins le header et sa bordure de 1px */
      min-height: calc(100svh - var(--header-height) - 1px);
      padding-block: var(--space-16);
      background-image: repeating-linear-gradient(
        90deg,
        rgba(233, 226, 208, 0.028) 0 2px,
        transparent 2px 30px
      );
    }

    /* ===== Vitrine (décor) ===== */

    .hero__vitrine {
      /* Distance des coins aux bords, modifiée dans la media query */
      --corner-offset: 4px;
      position: absolute;
      inset: 0;
      pointer-events: none;
      color: var(--color-accent-brass);
    }

    /* Filet net */
    .hero__vitrine::before {
      content: "";
      position: absolute;
      inset: 10px;
      border: 1px solid
        color-mix(in srgb, var(--color-accent-brass) 70%, transparent);
    }

    /* Filet pâle */
    .hero__vitrine::after {
      content: "";
      position: absolute;
      inset: 15px;
      border: 1px solid
        color-mix(in srgb, var(--color-accent-brass) 28%, transparent);
    }

    /* Un seul dessin (coin haut gauche), retourné en miroir pour les trois autres */
    .hero__corner {
      position: absolute;
      width: 34px;
      height: 34px;
    }

    .hero__corner--tl {
      top: var(--corner-offset);
      left: var(--corner-offset);
    }

    .hero__corner--tr {
      top: var(--corner-offset);
      right: var(--corner-offset);
      transform: scaleX(-1);
    }

    .hero__corner--bl {
      bottom: var(--corner-offset);
      left: var(--corner-offset);
      transform: scaleY(-1);
    }

    .hero__corner--br {
      bottom: var(--corner-offset);
      right: var(--corner-offset);
      transform: scale(-1, -1);
    }

    /* ===== Contenu ===== */

    .hero__inner {
      display: flex;
      flex-direction: column-reverse;
      align-items: stretch;
      gap: var(--space-12);
      /* Remplace la marge du .container pour dégager le contenu de la vitrine */
      padding-inline: var(--space-8);
    }

    .hero__text {
      display: flex;
      flex-direction: column;
      justify-content: space-around;
    }

    .hero__eyebrow {
      font-size: 1rem;
      color: var(--color-accent-brass);
      text-transform: uppercase;
      letter-spacing: 0.16em;
      margin-bottom: var(--space-4);
      font-family: var(--font-label);
    }

    .hero__eyebrow-line {
      display: block;
    }
    .hero__eyebrow-sep {
      display: none;
    }

    .hero__title {
      font-family: var(--font-display);
      font-size: var(--text-hero);
      color: var(--color-text-primary);
      margin-bottom: var(--space-6);
      font-style: italic;
      line-height: 0.95;
    }

    .hero__subtitle {
      color: var(--color-text-secondary);
      font-size: 1.4rem;
      max-width: 650px;
      margin-bottom: var(--space-8);
    }

    .hero__actions {
      display: flex;
      gap: var(--space-4);
      flex-wrap: wrap;
      flex-direction: column;
    }

    .hero__actions a {
      justify-content: center;
    }

    .hero__medallion {
      align-self: center;
    }

    .hero__nail {
      width: 100px;
      height: auto;
      color: var(--color-accent-brass);
      margin-bottom: -5px;
    }

    .hero__swing {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero__portrait-frame {
      width: 200px;
      height: 256px;
      padding: 9px;
      border-radius: 50%;
      border: 1px solid var(--color-accent-brass);
    }

    .hero__portrait-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
      border: 2px solid var(--color-accent-brass);
    }

    .hero__tag {
      display: flex;
      justify-content: center;
    }

    .hero__tag-hang {
      /* Longueur visible de la ficelle, modifiée dans la media query */
      --string-length: 14px;
      position: relative;
      padding-top: var(--string-length);
      transform: rotate(2.5deg);
      transform-origin: 50% 0;
    }

    /* La ficelle descend jusqu'au centre de l'œillet (6px de marge + 6px de rayon) */
    .hero__tag-hang::after {
      content: "";
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 1px;
      height: calc(var(--string-length) + 12px);
      background-color: var(--color-text-secondary);
    }

    .hero__tag-shadow {
      filter: drop-shadow(4px 5px 0 rgba(5, 13, 10, 0.45));
    }

    .hero__tag-card {
      position: relative;
      width: 250px;
      background-color: var(--color-bg-paper);
      color: var(--color-text-ink);
      padding: 24px 20px 12px;
      clip-path: polygon(
        16px 0,
        calc(100% - 16px) 0,
        100% 16px,
        100% 100%,
        0 100%,
        0 16px
      );
    }

    .hero__tag-eyelet {
      position: absolute;
      top: 6px;
      left: 50%;
      transform: translateX(-50%);
      border-radius: 50%;
      width: 12px;
      height: 12px;
      border: 2px solid var(--color-accent-brass-shadow);
      background-color: var(--color-bg-deep);
    }

    .hero__tag-title {
      font-weight: 700;
      font-size: 1rem;
      font-family: var(--font-label);
      letter-spacing: 0.14em;
      text-align: center;
      text-transform: uppercase;
      border-bottom: 2px solid var(--color-accent-bordeaux);
      padding-bottom: 6px;
      margin-bottom: var(--space-3);
    }

    .hero__tag-list {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 4px 12px;
      align-items: baseline;
    }

    .hero__tag-list dt {
      font-family: var(--font-label);
      font-size: 0.7rem;
      text-transform: uppercase;
      color: var(--color-accent-brass-dark);
    }

    .hero__tag-list dd {
      font-family: var(--font-display);
      font-size: 1rem;
    }

    .hero__tag-desktop {
      display: none;
    }

    /* Masqué en mobile : le contenu dépasse déjà l'écran et il recouvrirait les boutons */
    .hero__scroll {
      display: none;
      position: absolute;
      bottom: var(--space-4);
      left: 50%;
      transform: translateX(-50%);
      align-items: center;
      gap: var(--space-2);
      min-height: 44px;
      font-family: var(--font-label);
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--color-accent-brass);
      text-decoration: none;
    }

    @media (min-width: 768px) {
      .hero__vitrine {
        --corner-offset: 14px;
      }

      .hero__vitrine::before {
        inset: 24px;
      }

      .hero__vitrine::after {
        inset: 32px;
      }

      .hero__corner {
        width: 56px;
        height: 56px;
      }

      .hero__inner {
        padding-inline: 4.5rem;
      }

      .hero__actions {
        flex-wrap: nowrap;
        flex-direction: row;
      }

      .hero__portrait-frame {
        width: 345px;
        height: 442px;
        padding: 14px;
      }

      .hero__nail {
        width: 140px;
        margin-bottom: -7px;
      }

      .hero__tag-hang {
        --string-length: 16px;
      }

      .hero__tag-card {
        width: 280px;
      }

      .hero__tag-desktop {
        display: block;
      }
    }

    /* Écrans peu hauts (portables) : médaillon réduit pour que le hero tienne dans l'écran */
    @media (min-width: 768px) and (max-height: 920px) {
      .hero__portrait-frame {
        width: 300px;
        height: 384px;
      }
    }

    @media (min-width: 1024px) {
      .hero__inner {
        flex-direction: row;
      }

      .hero__text {
        flex: 1 1 480px;
      }

      .hero__scroll {
        display: inline-flex;
      }
    }

    @media (min-width: 1200px) {
      .hero__eyebrow-line {
        display: inline;
      }
      .hero__eyebrow-sep {
        display: inline;
      }
    }
  </style>
</section>
