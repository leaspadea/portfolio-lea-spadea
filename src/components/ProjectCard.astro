---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ProjectDetails from "./ProjectDetails.astro";
import type { ProjectDetailsContent } from "../data/project-details";

interface Props {
  title: string;
  description: string;
  category: string;
  status: string;
  details: ProjectDetailsContent;
  image: ImageMetadata;
  tags: string[];
  number: number;
  siteUrl?: string;
  repoUrl?: string;
  featured?: boolean;
}

const {
  title,
  description,
  category,
  status,
  details,
  image,
  tags,
  number,
  siteUrl,
  repoUrl,
  featured,
} = Astro.props;
const detailsId = `project-${number}-details`;
---

<article class:list={["card", "reveal", { "card--featured": featured }]}>
  <p class="card__tab">SPÉCIMEN N° 0{number}</p>
  <div class="card__cover">
    <div class="card__image-frame">
      <Image
        alt={title}
        src={image}
        loading="lazy"
        width={640}
        widths={[320, 480, 640, 960, 1280]}
        sizes={featured
          ? "(min-width: 1400px) 640px, (min-width: 768px) calc(50vw - 80px), calc(100vw - 76px)"
          : "(min-width: 1400px) 600px, (min-width: 660px) calc(50vw - 80px), calc(100vw - 76px)"}
      />
    </div>

    <div class="card__content">
      <h3>{title}</h3>
      <p class="card__meta">{category} · {status}</p>
      <p class="card__description">{description}</p>

      <div class="card__tags">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>

      <div class="card__links">
        <button
          type="button"
          class="card__open"
          data-project-open={detailsId}
          aria-controls={detailsId}
          aria-haspopup="dialog"
          aria-label={`Examiner le spécimen : ${title}`}
        >
          Examiner le spécimen <span aria-hidden="true">→</span>
        </button>
        {
          siteUrl && (
            <a
              class="link-underline"
              href={siteUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Voir le site →
            </a>
          )
        }
        {
          repoUrl && (
            <a
              class="link-underline"
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Voir le code →
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>

<ProjectDetails
  id={detailsId}
  title={title}
  number={number}
  category={category}
  status={status}
  details={details}
  siteUrl={siteUrl}
  repoUrl={repoUrl}
/>

<style>
  .card {
    overflow: visible;
    display: flex;
    flex-direction: column;
    /* Réserve la place de la feuille qui dépasse derrière la couverture. */
    padding-right: 6px;
    padding-bottom: 6px;
  }

  .card__cover {
    display: flex;
    flex-direction: column;
    flex: 1;
    background-color: var(--color-bg-forest);
    border: 1px solid var(--color-accent-brass);
    padding: 14px;
    box-shadow:
      4px 4px 0 var(--color-bg-paper),
      5px 5px 0 var(--color-border-paper);
  }

  .card__image-frame {
    position: relative;
    align-self: flex-start;
    background-color: var(--color-bg-paper-light);
    border: 1px solid var(--color-border-paper);
    /* La marge inférieure plus large évoque un tirage photographique. */
    padding: var(--space-2) var(--space-2) var(--space-6);
    transform: rotate(-1deg);
  }

  .card__image-frame img {
    width: 100%;
    aspect-ratio: 600 / 340;
    object-fit: cover;
    object-position: top;
    filter: sepia(0.18);
  }

  .card__content {
    padding-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .card__tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-end;
    min-width: 4rem;
    padding: var(--space-3) var(--space-6);
    border: 0;
    background-color: transparent;
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent-brass);
    font-size: 0.9rem;
    margin-bottom: -1px;
    margin-right: var(--space-6);
    position: relative;
    z-index: 1;
  }

  /* Deux formes superposées dessinent un filet qui suit les côtés inclinés. */
  .card__tab::before,
  .card__tab::after {
    content: "";
    position: absolute;
    clip-path: polygon(
      12px 0,
      calc(100% - 12px) 0,
      100% 100%,
      0 100%
    );
    pointer-events: none;
  }

  .card__tab::before {
    inset: 0;
    background-color: var(--color-accent-brass);
    z-index: -2;
  }

  .card__tab::after {
    /* Pas de retrait en bas : le vert rejoint directement la couverture. */
    inset: 1px 1px 0;
    background-color: var(--color-bg-forest);
    z-index: -1;
  }

  .card__content h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    margin-bottom: var(--space-2);
  }

  .card__description {
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    margin-bottom: var(--space-4);
  }

  .card__meta {
    margin-bottom: var(--space-4);
    font-family: var(--font-label);
    font-size: var(--text-small);
    color: var(--color-accent-brass);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .card__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    border-top: 1px dashed var(--color-border-subtle);
    padding-top: var(--space-4);
    margin-top: auto;
  }

  .card__links a {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-accent-brass);
    font-size: 1.05rem;
  }

  .card__open {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding-block: var(--space-1);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--color-accent-brass);
    text-decoration: none;
  }

  .card--featured .card__cover {
    gap: var(--space-6);
  }

  .card--featured .card__content h3 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  @media (min-width: 768px) {
    .card--featured .card__cover {
      flex-direction: row;
    }

    .card--featured .card__image-frame {
      flex: 1 1 50%;
      min-width: 0;
    }

    .card--featured .card__content {
      flex: 1 1 45%;
      min-width: 0;
    }
  }
</style>
