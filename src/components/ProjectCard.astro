---
interface Props {
  title: string;
  description: string;
  image: string;
  tags: string[];
  number?: number;
  siteUrl?: string;
  repoUrl?: string;
  featured?: boolean;
}

const { title, description, image, tags, number, siteUrl, repoUrl, featured } = Astro.props;
---

<article class:list={["card", "reveal", { "card--featured": featured }]}>
  <div class="card__image-frame">
    <img alt={title} src={image} loading="lazy" width="600" height="340" />
  </div>

  <div class="card__content">
    <p class="card__number"> SPÉCIMEN N° 0{number}</p>
    <h3>{title}</h3>
    <p class="card__description">{description}</p>

    <div class="card__tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>

    <div class="card__links">
      {siteUrl && <a href={siteUrl} target="_blank" rel="noopener noreferrer">Voir le site →</a>}
      {repoUrl && <a href={repoUrl} target="_blank" rel="noopener noreferrer">Voir le code →</a>}
    </div>
  </div>
</article>

<style>
  .card {
    background-color: var(--color-bg-forest);
    border: 1px solid var(--color-border-subtle);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 14px;
  }

  .card__image-frame {
    border: 1px solid var(--color-accent-brass);
    padding: 6px;
  }

  .card__image-frame img {
    width: 100%;
    aspect-ratio: 600 / 340;
    object-fit: cover;
    object-position: top;
    filter: sepia(0.18);
  }

  .card__content {
    padding-top: var(--space-4);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card__number {
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent-brass);
    font-size: 0.9rem;
    margin-bottom: var(--space-2);
  }

  .card__content h3 {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    margin-bottom: var(--space-2);
  }

  .card__description {
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    margin-bottom: var(--space-4);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .card__links {
    display: flex;
    gap: var(--space-4);
    border-top: 1px dashed var(--color-border-subtle);
    padding-top: var(--space-4);
    margin-top: auto;
  }

  .card__links a {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-accent-brass);
    font-size: 1.05rem;
  }

  .card__links a:hover {
    text-decoration: underline;
  }

  .card--featured {
    flex-direction: row;
    gap: var(--space-6);
  }

  .card--featured .card__image-frame {
    flex: 1 1 50%;
    min-width: 300px;
  }

  .card--featured .card__content {
    flex: 1 1 45%;
  }

  @media (max-width: 767px) {
    .card--featured {
      flex-direction: column;
    }
  }
</style>