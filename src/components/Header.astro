<header class="header">
  <nav class="header__nav container" aria-label="Navigation principale">
    <a href="#" class="header__logo" aria-label="Retour en haut de page">
      <span class="header__monogram">LS</span>
    </a>

    <!-- Bouton burger (mobile) -->
    <button
      class="header__burger"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Ouvrir le menu"
    >
      <span class="header__burger-line"></span>
      <span class="header__burger-line"></span>
      <span class="header__burger-line"></span>
    </button>

    <!-- Menu de navigation -->
    <ul id="nav-menu" class="header__menu" role="list">
      <li><a href="#projets" class="header__link">La collection</a></li>
      <li><a href="#a-propos" class="header__link">À propos</a></li>
      <li><a href="#contact" class="header__link">Correspondance</a></li>
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    var burger = document.querySelector(".header__burger");
    var menu = document.querySelector(".header__menu");

    burger.addEventListener("click", function () {
      var isOpen = burger.getAttribute("aria-expanded") === "true";
      burger.setAttribute("aria-expanded", String(!isOpen));
      menu.classList.toggle("header__menu--open");
      burger.setAttribute(
        "aria-label",
        isOpen ? "Ouvrir le menu" : "Fermer le menu",
      );
    });

    // Ferme le menu quand on clique sur un lien
    menu.querySelectorAll(".header__link").forEach(function (link) {
      link.addEventListener("click", function () {
        burger.setAttribute("aria-expanded", "false");
        menu.classList.remove("header__menu--open");
        burger.setAttribute("aria-label", "Ouvrir le menu");
      });
    });
  })();
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-bg-deep);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 8rem;
  }

  .header__logo {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-accent-brass);
    text-decoration: none;
    width: 65px;
    height: 78px;
    border-radius: 50%;
    border: 1px solid var(--color-accent-brass);
    outline: 1px solid var(--color-accent-brass);
    outline-offset: -6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-style: italic;
  }

  /* Burger — 3 lignes */
  .header__burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2rem;
    height: 2rem;
  }

  .header__burger-line {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--color-text-primary);
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .header__burger[aria-expanded="true"] .header__burger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .header__burger[aria-expanded="true"] .header__burger-line:nth-child(2) {
    opacity: 0;
  }

  .header__burger[aria-expanded="true"] .header__burger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Menu mobile : caché par défaut */
  .header__menu {
    display: none;
    flex-direction: column;
    gap: var(--space-4);
    position: absolute;
    top: 8rem;
    left: 0;
    right: 0;
    padding: var(--space-6) var(--gutter);
    background-color: var(--color-bg-deep);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .header__menu--open {
    display: flex;
  }

  .header__link {
    font-family: var(--font-label);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .header__link:hover {
    color: var(--color-accent-brass);
    text-decoration: none;
  }

  /* Desktop (≥768px) */
  @media (min-width: 768px) {
    .header__burger {
      display: none;
    }

    .header__menu {
      display: flex;
      flex-direction: row;
      gap: var(--space-8);
      position: static;
      padding: 0;
      background: none;
      border: none;
    }
  }

  /* Réduit les animations si demandé */
  @media (prefers-reduced-motion: reduce) {
    .header__burger-line {
      transition: none;
    }
  }
</style>
