---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="divider footer__divider" aria-hidden="true">
      <svg
        width="64"
        height="16"
        viewBox="0 0 64 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.2"
      >
        <circle cx="6" cy="8" r="2" />
        <path d="M20 8 L32 2 L44 8 L32 14 Z" />
        <circle cx="58" cy="8" r="2" />
      </svg>
    </div>

    <p class="footer__credit">© {year} Léa Spadea · Fait main</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-8);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .footer__divider {
    width: 100%;
    max-width: 32rem;
    margin: 0;
  }

  .footer__credit {
    margin: 0;
    color: var(--color-text-secondary);
    font-family: var(--font-label);
    font-size: var(--text-small);
    line-height: 1.6;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }
</style>
