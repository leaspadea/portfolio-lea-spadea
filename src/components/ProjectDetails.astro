---
import type { ProjectDetailsContent } from "../data/project-details";

interface Props {
  id: string;
  title: string;
  number: number;
  category: string;
  status: string;
  details: ProjectDetailsContent;
  siteUrl?: string;
  repoUrl?: string;
}

const { id, title, number, category, status, details, siteUrl, repoUrl } = Astro.props;
const titleId = `${id}-title`;
---

<dialog
  id={id}
  class="project-details"
  aria-labelledby={titleId}
  data-project-details
>
  <header class="project-details__header">
    <div>
      <p class="project-details__inventory">Spécimen n° 0{number} · Fiche de collection</p>
      <h2 id={titleId} class="project-details__title" tabindex="-1" data-project-initial-focus>
        {title}
      </h2>
      <p class="project-details__meta">{category} · {status}</p>
    </div>
    <button type="button" class="project-details__close" data-project-close>
      Fermer <span aria-hidden="true">×</span>
    </button>
  </header>

  <div class="project-details__body">
    <div class="project-details__page">
      <section class="project-details__section">
        <h3><span aria-hidden="true">01</span> Contexte</h3>
        <p>{details.context}</p>
      </section>
      <section class="project-details__section">
        <h3><span aria-hidden="true">02</span> Objectifs</h3>
        <ul>{details.objectives.map((objective) => <li>{objective}</li>)}</ul>
      </section>
      <section class="project-details__section">
        <h3><span aria-hidden="true">03</span> Stack</h3>
        <ul class="project-details__stack">
          {details.stack.map((technology) => <li>{technology}</li>)}
        </ul>
      </section>
    </div>

    <div class="project-details__page">
      <section class="project-details__section">
        <h3><span aria-hidden="true">04</span> Compétences développées</h3>
        <ul>{details.skills.map((skill) => <li>{skill}</li>)}</ul>
      </section>
      <section class="project-details__section">
        <h3><span aria-hidden="true">05</span> Résultats</h3>
        <ul>{details.results.map((result) => <li>{result}</li>)}</ul>
      </section>
      <section class="project-details__section">
        <h3><span aria-hidden="true">06</span> Perspectives d’amélioration</h3>
        <ul>{details.improvements.map((improvement) => <li>{improvement}</li>)}</ul>
      </section>
    </div>
  </div>

  <footer class="project-details__footer">
    <p>Pièce n° 0{number} · La collection</p>
    <div class="project-details__links">
      {
        siteUrl && (
          <a class="link-underline" href={siteUrl} target="_blank" rel="noopener noreferrer">
            Voir le site <span aria-hidden="true">↗</span>
          </a>
        )
      }
      {
        repoUrl && (
          <a class="link-underline" href={repoUrl} target="_blank" rel="noopener noreferrer">
            Voir le code <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </div>
  </footer>
</dialog>

<script>
  import "../scripts/project-details";
</script>

<style>
  .project-details {
    position: fixed;
    inset: 0;
    width: min(1120px, calc(100% - var(--space-8)));
    max-width: none;
    max-height: calc(100dvh - var(--space-8));
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-accent-brass);
    background-color: var(--color-bg-forest);
    color: var(--color-text-primary);
    box-shadow: 0 16px 48px color-mix(in srgb, var(--color-bg-deep) 70%, transparent);
  }

  /* Le dialogue fermé conserve le display:none fourni par le navigateur. */
  .project-details[open] {
    display: flex;
    flex-direction: column;
  }

  .project-details::backdrop {
    background-color: color-mix(in srgb, var(--color-bg-deep) 82%, transparent);
  }

  .project-details__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    flex-shrink: 0;
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-accent-brass);
  }

  .project-details__header > div {
    min-width: 0;
  }

  .project-details__inventory {
    margin-bottom: var(--space-2);
    font-family: var(--font-label);
    font-size: var(--text-caption);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-brass);
  }

  .project-details__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .project-details__meta {
    margin-top: var(--space-2);
    font-family: var(--font-label);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .project-details__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-accent-brass);
    font-family: var(--font-label);
    font-size: var(--text-small);
    color: var(--color-text-primary);
  }

  .project-details__close span {
    font-size: 1.5rem;
    line-height: 1;
  }

  .project-details__close:hover {
    background-color: var(--color-bg-surface);
  }

  /* Seules les feuilles défilent : la fermeture reste toujours disponible. */
  .project-details__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    min-height: 0;
    padding: var(--space-3);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-color: var(--color-accent-brass-dark) var(--color-bg-paper);
    background-color: var(--color-bg-paper);
    color: var(--color-text-ink);
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .project-details__page {
    min-width: 0;
    padding: var(--space-4);
    border: 1px solid var(--color-border-paper);
    background-color: var(--color-bg-paper-light);
    box-shadow: 3px 3px 0 var(--color-shadow-paper);
  }

  .project-details__section + .project-details__section {
    margin-top: var(--space-8);
  }

  .project-details__section h3 {
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.3;
    text-wrap: pretty;
  }

  .project-details__section h3 span {
    margin-right: var(--space-2);
    font-family: var(--font-label);
    font-size: var(--text-small);
    color: var(--color-accent-brass-dark);
  }

  .project-details__section ul {
    padding-left: var(--space-4);
    list-style: disc;
  }

  .project-details__section li + li {
    margin-top: var(--space-2);
  }

  .project-details__section .project-details__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .project-details__stack li {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--color-border-paper);
    background-color: var(--color-bg-paper);
    font-family: var(--font-label);
    font-size: var(--text-small);
  }

  .project-details__stack li + li {
    margin-top: 0;
  }

  .project-details__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-shrink: 0;
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-accent-brass);
    font-size: var(--text-small);
  }

  .project-details__footer p {
    font-family: var(--font-label);
    color: var(--color-text-secondary);
  }

  .project-details__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    color: var(--color-accent-brass);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.125rem;
  }

  @media (min-width: 768px) {
    .project-details__header {
      padding: var(--space-6) var(--space-8);
    }

    .project-details__body {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: var(--space-4);
    }

    .project-details__page {
      padding: var(--space-6);
    }

    .project-details__footer {
      padding-inline: var(--space-8);
    }
  }

  @media (max-height: 500px) {
    .project-details__header {
      padding: var(--space-3) var(--space-4);
    }

    .project-details__inventory {
      margin-bottom: var(--space-1);
    }

    .project-details__title {
      font-size: 1.5rem;
    }

    .project-details__footer > p {
      display: none;
    }
  }
</style>
